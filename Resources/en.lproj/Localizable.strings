/* MenuPanelView */
"启用麦克风直通" = "Enable Mic Passthrough";
"未在运行" = "Not Running";
"已停止" = "Stopped";
"运行中" = "Running";
"没有麦克风权限" = "No Microphone Permission";
"允许 MicMonitor 访问麦克风后才能工作。" = "MicMonitor needs microphone access to work.";
"打开系统设置" = "Open System Settings";
"检测到啸叫(麦克风拾取了耳机的声音),已自动降低音量至 %lld%。建议换用离耳机更远的麦克风(如笔记本内置麦克风),或调低混入音量。" = "Feedback detected (the mic is picking up your headphones). Volume auto-lowered to %lld%%. Use a mic farther from the headphones (e.g. the built-in mic), or lower the mix volume.";
"输入和输出是同一台蓝牙设备:使用它的麦克风会把耳机切换到通话模式(HFP),音乐音质会明显下降。建议选择内置麦克风。" = "Input and output are the same Bluetooth device: using its mic switches it to call mode (HFP) and noticeably degrades music quality. Consider the built-in microphone.";
"输入设备(麦克风)" = "Input (Microphone)";
"输出设备(耳机)" = "Output (Headphones)";
"系统默认(%@)" = "System Default (%@)";
"(蓝牙)" = "(Bluetooth)";
"混入音量" = "Mix Volume";
"取消静音" = "Unmute";
"静音" = "Mute";
"噪声门" = "Noise Gate";
"环境安静但耳机里有持续底噪时开启;电平低于阈值的声音不混入。看电平条把阈值设在「底噪之上、说话声之下」。" = "Turn on when a constant hiss is audible in quiet environments; sounds below the threshold won't be mixed in. Use the level meter to set the threshold above the noise floor but below speech.";
"阈值" = "Threshold";
"实时输入电平(%@ dB)" = "Live Input Level (%@ dB)";
"人声突显" = "Voice Focus";
"检测到语音时正常播放;无人声时按「压低量」衰减,突出说话声、压低环境噪声。可与噪声门叠加。灵敏度过低可能把人声也压掉,过高则失去过滤效果;结合下方状态指示调节。" = "Plays normally while speech is detected; attenuates non-speech sounds by the Ducking amount to emphasize voices over ambient noise. Stacks with the noise gate. Too low a sensitivity may also duck real speech; too high defeats the filter — tune with the live indicator below.";
"压低量" = "Ducking";
"灵敏度" = "Sensitivity";
"当前状态:检测到语音" = "Status: speech detected";
"当前状态:非人声(已压低)" = "Status: non-speech (ducked)";
"人声增强(系统语音处理)" = "Voice Enhance (System Speech Processing)";
"调用 macOS 系统语音处理(FaceTime 同款):自动增益(远处人声也会拉清楚)、降噪、回声消除。开启后走双引擎路径;音量建议降回 100% 左右。" = "Uses macOS system voice processing (the same engine FaceTime uses): automatic gain control lifts quiet/distant voices, plus noise suppression and echo cancellation. Switches to the dual-engine path; try keeping the mix volume around 100%.";
"低延迟模式(减少回声感)" = "Low-Latency Mode (reduces echo)";
"启用后请求更小的设备 IO 缓冲,端到端延迟更低、回声感更弱;设备跟不上时若声音卡顿、欠载增加,可关闭回退。" = "Requests a smaller I/O buffer on the devices for lower end-to-end latency and less echo feel. If audio stutters or underruns increase, turn this off to fall back.";
"在 Dock 中显示图标" = "Show Icon in Dock";
"开启后可点 Dock 图标打开此面板;菜单栏图标仍会保留。" = "When on, click the Dock icon to open this panel; the menu bar icon remains.";
"开机自启" = "Launch at Login";
"登录后自动启动 MicMonitor。若系统提示需要批准,去 系统设置 → 通用 → 登录项 中允许。" = "Starts MicMonitor automatically after login. If macOS asks for approval, allow it under System Settings → General → Login Items.";
"需在 系统设置 → 通用 → 登录项 中允许 MicMonitor" = "Allow MicMonitor under System Settings → General → Login Items";
"缓冲" = "Buffer";
"欠载" = "Underruns";
"丢弃" = "Dropped";
"重建" = "Rebuilds";
"检测到设备不稳定,已自动将缓冲放大至 ×%@(延迟增加,换取不再卡顿)" = "Unstable device detected — buffer auto-scaled to ×%@ (adds latency, avoids stuttering)";
"打开日志" = "Open Log";
"复制诊断信息" = "Copy Diagnostics";
"退出" = "Quit";

